# ---------------------------------------------------------------------------
# Public site configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://drzara-iqbalkhan.com

# Contact details shown across the site (all optional; defaults are placeholders).
NEXT_PUBLIC_CONTACT_EMAIL=appointments@drzara-iqbalkhan.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_BOOKING_URL=

# ---------------------------------------------------------------------------
# Sanity CMS (all optional). When these are empty the site renders from the
# typed local fallback content in src/content and the Studio is disabled.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# Optional: secret used to authenticate on-demand revalidation
SANITY_REVALIDATE_SECRET=
